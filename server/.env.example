# Copy this file to .env and fill in YOUR OWN values. Never commit .env.
# The .env file you provided for this project only contains MongoDB keys;
# every other value below must be added by you before first run.

# Database: either form works. MONGO_URI takes precedence over MONGODB_URI.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# If your provider file splits credentials instead of a full URI, these are also read as a fallback:
# MONGODB_USERNAME=<your-db-username>
# MONGODB_PASSWORD=<your-db-password>

PORT=5000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CLIENT_URL=http://localhost:5173

# Auth: use a long random string. The server refuses to start in production without one.
JWT_SECRET=<a-long-random-secret-at-least-32-characters>
JWT_EXPIRE=7d
COOKIE_EXPIRE_DAYS=7

# Cloudinary (optional until you upload images; seed data uses public image URLs)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# First admin, created by: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password>

# Store defaults (also editable later in Settings in the admin panel)
STORE_NAME=Apple Ahmad
WHATSAPP_NUMBER=923000000000
DELIVERY_CHARGE=300
FREE_DELIVERY_THRESHOLD=50000
